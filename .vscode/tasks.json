{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HALLOWETH: Build (Release)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/build.ps1"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "HALLOWETH: Build (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/build.ps1",
        "-Config", "Debug"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "HALLOWETH: Clean rebuild",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/build.ps1",
        "-Clean"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "HALLOWETH: Install VST3",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/install-vst3.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
